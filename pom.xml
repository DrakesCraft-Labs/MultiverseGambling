<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.chagui68</groupId>
  <artifactId>multiversegambling</artifactId>
  <version>1.0.6</version>
  <packaging>jar</packaging>

  <name>MultiverseGambling</name>
  <description>Chance and betting engine with a catalogue of solo and group minigames.</description>

  <developers>
    <developer>
      <name>Chagui68</name>
    </developer>
  </developers>

  <properties>
    <java.version>21</java.version>
    <paper.api>1.21.11-R0.1-SNAPSHOT</paper.api>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- The server provides the API at runtime: it is never bundled. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.api}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Optional hook into the server economy. When missing, the internal wallet is used. -->
    <dependency>
      <groupId>com.github.MilkBowl</groupId>
      <artifactId>VaultAPI</artifactId>
      <version>1.7.1</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>org.bukkit</groupId>
          <artifactId>bukkit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.name}-${project.version}</finalName>
    <resources>
      <!-- Only plugin.yml is filtered: the other YAML files use raw config keys. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
      </plugin>
    </plugins>
  </build>
  <!--
      The release jar is built against Paper 1.21.11 and runs on 1.21.11, 26.1 and 26.2.
      These profiles compile (and test) the same sources against the newer APIs, so a call
      that does not exist there is caught before release. The 26.x APIs need JDK 25:
          mvn -P api-26.1 test
          mvn -P api-26.2 test
  -->
  <profiles>
    <profile>
      <id>api-26.1</id>
      <properties>
        <paper.api>26.1.2.build.74-stable</paper.api>
      </properties>
    </profile>
    <profile>
      <id>api-26.2</id>
      <properties>
        <paper.api>26.2.build.124-stable</paper.api>
      </properties>
    </profile>
  </profiles>
</project>
